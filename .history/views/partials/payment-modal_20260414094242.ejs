<div id="paymentModal" class="modal" style="display:none">
  <div class="modal-box payment-modal-box">
    <div class="modal-header">
      <h3><i class="fas fa-shield-check"></i> Online Payment Gateway</h3>
      <button type="button" onclick="closePaymentModal()" class="modal-close">&times;</button>
    </div>
    <div class="modal-form payment-modal-content">
      <div class="gateway-summary">
        <div>
          <small>Merchant</small>
          <strong id="gatewayMerchantName">PTouristiX</strong>
        </div>
        <div class="gateway-amount">
          <small>Payable</small>
          <strong id="gatewayPayableAmount">BDT 0</strong>
        </div>
      </div>

      <div class="booking-context-card">
        <div class="booking-context-head">
          <small>Booking Details</small>
          <strong id="bookingContextType">Booking</strong>
        </div>
        <div id="bookingContextRows" class="booking-context-rows"></div>
      </div>

      <div class="payment-step active" data-step="choice">
        <div class="form-group">
          <label>Select Payment Method</label>
          <div class="payment-options">
            <button type="button" class="payment-option payment-wallet" data-method="wallet">
              <span class="payment-name">My Wallet Balance</span>
              <small>Pay instantly from your in-app wallet</small>
            </button>
            <button type="button" class="payment-option payment-bkash" data-method="bkash">
              <span class="payment-name">bKash</span>
              <small>Automatic gateway checkout</small>
            </button>
            <button type="button" class="payment-option payment-nagad" data-method="nagad">
              <span class="payment-name">Nagad</span>
              <small>Automatic gateway checkout</small>
            </button>
          </div>
        </div>

        <div class="gateway-instructions">
          <h4>Before payment</h4>
          <p class="muted-text" style="margin:0;">
            Choose your payment method, then continue to view merchant details and add co-traveler information for this booking.
          </p>
        </div>

        <div class="co-traveler-section">
          <div class="co-traveler-header">
            <div>
              <h4>Co-Traveler Details</h4>
              <p class="muted-text" id="coTravelerHelpText">No co-traveler details needed for this booking.</p>
            </div>
            <span class="co-traveler-count" id="coTravelerCountBadge">0</span>
          </div>
          <div id="coTravelerFields" class="co-traveler-fields"></div>
        </div>

        <button type="button" class="btn-primary btn-block" onclick="goToPaymentDetails()">
          Continue to Payment
        </button>
      </div>

      <div class="payment-step" data-step="details">
        <div class="gateway-instructions">
          <h4 id="paymentDetailTitle">Merchant account details</h4>
          <p class="muted-text" id="paymentDetailText" style="margin-bottom:10px;">
            Review the payment information below before completing your booking.
          </p>
          <div class="merchant-card" id="merchantCard">
            <div class="merchant-row">
              <span>Merchant</span>
              <strong id="merchantAccountName">Selected service</strong>
            </div>
            <div class="merchant-row">
              <span>Payment Method</span>
              <strong id="merchantMethodLabel">bKash</strong>
            </div>
            <div class="merchant-row">
              <span>Merchant Number</span>
              <strong id="merchantAccountNumber">01753340968</strong>
            </div>
            <div class="merchant-row">
              <span>Reference</span>
              <strong>Auto-generated after confirmation</strong>
            </div>
          </div>
        </div>

        <p class="muted-text gateway-note">
          Your booking is being processed. You will be redirected to My Bookings automatically.
        </p>

        <div class="payment-step-actions">
          <button type="button" class="btn-outline" onclick="backToPaymentChoice()">Back</button>
          <button type="button" class="btn-primary" id="autoRedirectButton" onclick="confirmGatewayPayment()">Booking Confirm</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  let pendingPaymentForm = null;
  let selectedMethod = '';

  const methodMeta = {
    transport: {
      wallet: {
        label: 'Wallet',
        title: 'Transport wallet payment',
        body: 'The selected transport ticket total will be deducted from the user wallet after confirmation.',
        merchantName: 'TouristiX Wallet',
        merchantNumber: 'Internal wallet balance'
      },
      bkash: {
        label: 'bKash',
        title: 'Transport ticket bKash account details',
        body: 'Pay using the official transport ticket merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Transport Ticket Desk',
        merchantNumber: '01753340968'
      },
      nagad: {
        label: 'Nagad',
        title: 'Transport ticket Nagad account details',
        body: 'Pay using the official transport ticket merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Transport Ticket Desk',
        merchantNumber: '01753340968'
      }
    },
    hotel: {
      wallet: {
        label: 'Wallet',
        title: 'Hotel wallet payment',
        body: 'The hotel booking total will be deducted from the user wallet after confirmation.',
        merchantName: 'TouristiX Wallet',
        merchantNumber: 'Internal wallet balance'
      },
      bkash: {
        label: 'bKash',
        title: 'Hotel booking bKash account details',
        body: 'Pay using the dedicated hotel booking merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Hotel Booking Desk',
        merchantNumber: '01753340981'
      },
      nagad: {
        label: 'Nagad',
        title: 'Hotel booking Nagad account details',
        body: 'Pay using the dedicated hotel booking merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Hotel Booking Desk',
        merchantNumber: '01753340981'
      }
    },
    guide: {
      wallet: {
        label: 'Wallet',
        title: 'Guide hire wallet payment',
        body: 'The guide hire total will be deducted from the user wallet after confirmation.',
        merchantName: 'TouristiX Wallet',
        merchantNumber: 'Internal wallet balance'
      },
      bkash: {
        label: 'bKash',
        title: 'Guide hire bKash account details',
        body: 'Pay using the dedicated guide hire merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Guide Hire Desk',
        merchantNumber: '01753340982'
      },
      nagad: {
        label: 'Nagad',
        title: 'Guide hire Nagad account details',
        body: 'Pay using the dedicated guide hire merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Guide Hire Desk',
        merchantNumber: '01753340982'
      }
    },
    package: {
      wallet: {
        label: 'Wallet',
        title: 'Package wallet payment',
        body: 'The package purchase total will be deducted from the user wallet after confirmation.',
        merchantName: 'TouristiX Wallet',
        merchantNumber: 'Internal wallet balance'
      },
      bkash: {
        label: 'bKash',
        title: 'Package purchase bKash account details',
        body: 'Pay using the dedicated package sales merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Package Sales Desk',
        merchantNumber: '01753340983'
      },
      nagad: {
        label: 'Nagad',
        title: 'Package purchase Nagad account details',
        body: 'Pay using the dedicated package sales merchant account below. The gateway reference will be created automatically.',
        merchantName: 'BanglaTour Package Sales Desk',
        merchantNumber: '01753340983'
      }
    }
  };

  function qs(id) {
    return document.getElementById(id);
  }

  function setHiddenValue(form, key, value) {
    let input = form.querySelector(`input[name="${key}"]`);
    if (!input) {
      input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      form.appendChild(input);
    }
    input.value = value;
  }

  function getTotalAmount(form) {
    const totalInput = form.querySelector('input[name="total_price"]');
    const amount = Number(totalInput ? totalInput.value : 0);
    return Number.isFinite(amount) ? amount : 0;
  }

  function getTravelerCount(form) {
    const explicitCountInput = form.querySelector('input[name="traveler_count"]');
    const explicitCount = Number(explicitCountInput ? explicitCountInput.value : 0);
    if (Number.isFinite(explicitCount) && explicitCount > 0) return Math.max(1, Math.floor(explicitCount));
    const personsInput = form.querySelector('input[name="persons"]');
    const count = Number(personsInput ? personsInput.value : 1);
    if (Number.isFinite(count) && count > 0) return Math.max(1, Math.floor(count));
    return 1;
  }

  function getBookingKind(form) {
    const explicitKind = String(form?.dataset?.bookingKind || '').trim().toLowerCase();
    if (explicitKind) return explicitKind;
    const action = String(form?.getAttribute('action') || '').toLowerCase();
    if (action.includes('/book/hotel')) return 'hotel';
    if (action.includes('/book/guide')) return 'guide';
    if (action.includes('/book/package')) return 'package';
    if (action.includes('/book/transport')) return 'transport';
    return 'transport';
  }

  function getInputValue(form, selector) {
    const el = form.querySelector(selector);
    return el ? String(el.value || '').trim() : '';
  }

  function getMerchantDisplayName(form) {
    const kind = getBookingKind(form);
    if (kind === 'hotel') return getInputValue(form, 'input[name="hotel_name"]') || 'Hotel';
    if (kind === 'guide') return getInputValue(form, 'input[name="guide_name"]') || 'Guide';
    if (kind === 'package') return getInputValue(form, 'input[name="pkg_name"]') || 'Package';
    return getInputValue(form, 'input[name="transport_name"]') || 'Transport';
  }

  function setBookingContext(form) {
    const kind = getBookingKind(form);
    const rows = [];
    let label = 'Booking';

    if (kind === 'transport') {
      label = 'Transport Booking';
      rows.push(['Service', getInputValue(form, 'input[name="transport_name"]') || 'Transport']);
      rows.push(['Travel Date', getInputValue(form, 'input[name="travel_date"]') || '-']);
      rows.push(['Seats', getInputValue(form, 'input[name="seat_numbers"]') || 'Not selected']);
      rows.push(['Passengers', getInputValue(form, 'input[name="persons"]') || '1']);
    } else if (kind === 'hotel') {
      label = 'Hotel Booking';
      const checkIn = getInputValue(form, 'input[name="check_in"]');
      const checkOut = getInputValue(form, 'input[name="check_out"]');
      const personCount = getInputValue(form, 'input[name="persons"]') || '1';
      let stayLength = '-';
      if (checkIn && checkOut) {
        const nights = Math.max(1, Math.round((new Date(checkOut) - new Date(checkIn)) / 86400000));
        stayLength = `${nights} night(s)`;
      }
      rows.push(['Hotel', getInputValue(form, 'input[name="hotel_name"]') || 'Hotel']);
      rows.push(['Check-in', checkIn || '-']);
      rows.push(['Check-out', checkOut || '-']);
      rows.push(['Stay', stayLength]);
      rows.push(['Guests', personCount]);
    } else if (kind === 'guide') {
      label = 'Guide Booking';
      rows.push(['Guide', getInputValue(form, 'input[name="guide_name"]') || 'Guide']);
      rows.push(['Start Date', getInputValue(form, 'input[name="start_date"]') || '-']);
      rows.push(['Duration', `${getInputValue(form, 'input[name="days"]') || '1'} day(s)`]);
      rows.push(['Traveler', '1']);
    } else if (kind === 'package') {
      label = 'Package Booking';
      rows.push(['Package', getInputValue(form, 'input[name="pkg_name"]') || 'Package']);
      rows.push(['Travel Date', getInputValue(form, 'input[name="travel_date"]') || '-']);
      rows.push(['Travelers', getInputValue(form, 'input[name="persons"]') || '1']);
    }

    qs('bookingContextType').textContent = label;
    qs('bookingContextRows').innerHTML = rows.map(([key, value]) => (
      `<div class="merchant-row"><span>${key}</span><strong>${value || '-'}</strong></div>`
    )).join('');
  }

  function updatePayableAmount(form) {
    const amount = getTotalAmount(form);
    const payable = amount + Math.ceil(amount * 0.01);
    qs('gatewayPayableAmount').textContent = `BDT ${payable.toLocaleString()}`;
  }

  function showStep(stepName) {
    document.querySelectorAll('#paymentModal .payment-step').forEach((panel) => {
      panel.classList.toggle('active', panel.dataset.step === stepName);
    });
  }

  function renderCoTravelerFields(form) {
    const container = qs('coTravelerFields');
    const helpText = qs('coTravelerHelpText');
    const badge = qs('coTravelerCountBadge');
    if (!container || !helpText || !badge) return;

    container.innerHTML = '';
    const travelerCount = getTravelerCount(form);
    const extraTravelers = Math.max(0, travelerCount - 1);
    badge.textContent = String(extraTravelers);

    if (!extraTravelers) {
      helpText.textContent = 'No co-traveler details needed for this booking.';
      return;
    }

    helpText.textContent = `Add optional details for ${extraTravelers} co-traveler${extraTravelers > 1 ? 's' : ''}.`;
    for (let i = 0; i < extraTravelers; i += 1) {
      const card = document.createElement('div');
      card.className = 'co-traveler-card';
      card.innerHTML = `
        <div class="co-traveler-card-title">Co-Traveler ${i + 1}</div>
        <div class="co-traveler-grid">
          <input type="text" class="form-control co-traveler-input" data-field="name" data-index="${i}" placeholder="Full name" />
          <input type="number" class="form-control co-traveler-input" data-field="age" data-index="${i}" min="1" max="120" placeholder="Age" />
          <select class="form-control co-traveler-input" data-field="gender" data-index="${i}">
            <option value="">Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
          <input type="text" class="form-control co-traveler-input" data-field="phone" data-index="${i}" placeholder="Phone number" />
          <input type="text" class="form-control co-traveler-input co-traveler-wide" data-field="relation" data-index="${i}" placeholder="Relation or note" />
        </div>
      `;
      container.appendChild(card);
    }
  }

  function collectCoTravelers() {
    const grouped = new Map();
    document.querySelectorAll('#coTravelerFields .co-traveler-input').forEach((input) => {
      const index = Number(input.dataset.index || 0);
      const field = input.dataset.field;
      const item = grouped.get(index) || {};
      item[field] = String(input.value || '').trim();
      grouped.set(index, item);
    });
    return Array.from(grouped.values()).filter((item) =>
      Object.values(item).some((value) => String(value || '').trim() !== '')
    );
  }

  function updatePaymentDetails() {
    const bookingKind = getBookingKind(pendingPaymentForm) || 'transport';
    const meta = (methodMeta[bookingKind] && methodMeta[bookingKind][selectedMethod]) || methodMeta.transport.wallet;
    const merchantDisplayName = selectedMethod === 'wallet' ? meta.merchantName : getMerchantDisplayName(pendingPaymentForm);
    qs('paymentDetailTitle').textContent = meta.title;
    qs('paymentDetailText').textContent = meta.body;
    qs('merchantAccountName').textContent = merchantDisplayName;
    qs('merchantMethodLabel').textContent = meta.label;
    qs('merchantAccountNumber').textContent = meta.merchantNumber;
    qs('gatewayMerchantName').textContent = merchantDisplayName;
  }

  function selectGateway(method) {
    selectedMethod = method;
    document.querySelectorAll('.payment-option').forEach((btn) => {
      btn.classList.toggle('selected', btn.dataset.method === method);
    });
  }

  window.closePaymentModal = function closePaymentModal() {
    const modal = qs('paymentModal');
    if (modal) modal.style.display = 'none';
    pendingPaymentForm = null;
    selectedMethod = '';
    showStep('choice');
    document.querySelectorAll('.payment-option').forEach((btn) => btn.classList.remove('selected'));
    if (qs('coTravelerFields')) qs('coTravelerFields').innerHTML = '';
    if (qs('coTravelerHelpText')) qs('coTravelerHelpText').textContent = 'No co-traveler details needed for this booking.';
    if (qs('coTravelerCountBadge')) qs('coTravelerCountBadge').textContent = '0';
  };

  window.goToPaymentDetails = function goToPaymentDetails() {
    if (!pendingPaymentForm) return;
    if (!selectedMethod) {
      alert('Please select a payment method first.');
      return;
    }
    setHiddenValue(pendingPaymentForm, 'return_to', '/dashboard');
    updatePaymentDetails();
    showStep('details');
  };

  window.backToPaymentChoice = function backToPaymentChoice() {
    showStep('choice');
  };

  window.confirmGatewayPayment = function confirmGatewayPayment() {
    if (!pendingPaymentForm || !selectedMethod) return;

    setHiddenValue(pendingPaymentForm, 'payment_method', selectedMethod);
    setHiddenValue(pendingPaymentForm, 'payment_number', '');
    setHiddenValue(pendingPaymentForm, 'payment_txn_id', '');
    setHiddenValue(pendingPaymentForm, 'co_travelers', JSON.stringify(collectCoTravelers()));
    setHiddenValue(pendingPaymentForm, 'return_to', '/dashboard');

    const formToSubmit = pendingPaymentForm;
    closePaymentModal();
    formToSubmit.submit();
  };

  document.querySelectorAll('.payment-option').forEach((btn) => {
    btn.addEventListener('click', () => selectGateway(btn.dataset.method));
  });

  document.querySelectorAll('form.js-payment-form').forEach((form) => {
    form.addEventListener('submit', (event) => {
      const methodValue = (form.querySelector('input[name="payment_method"]') || {}).value;
      if (methodValue) return;

      event.preventDefault();
    pendingPaymentForm = form;
    updatePayableAmount(form);
    setBookingContext(form);
    renderCoTravelerFields(form);
    showStep('choice');
      const modal = qs('paymentModal');
      if (modal) modal.style.display = 'flex';
    });
  });
})();
</script>
