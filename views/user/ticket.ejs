<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #0f172a;
      padding: 24px;
    }
    .ticket-shell {
      max-width: 820px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid #dbe4f0;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    }
    .ticket-head {
      background: linear-gradient(135deg, #065f46, #059669);
      color: #ffffff;
      padding: 24px;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
    }
    .ticket-head h1 {
      margin: 0 0 8px;
      font-size: 30px;
    }
    .ticket-chip {
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }
    .ticket-body {
      padding: 24px;
      display: grid;
      gap: 20px;
    }
    .ticket-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .ticket-card {
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 16px;
      background: #f8fafc;
    }
    .ticket-card h3 {
      margin: 0 0 12px;
      font-size: 18px;
    }
    .ticket-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .ticket-row span:first-child {
      color: #64748b;
    }
    .traveler-list {
      display: grid;
      gap: 10px;
    }
    .traveler-item {
      background: #ffffff;
      border: 1px solid #dbe4f0;
      border-radius: 12px;
      padding: 12px;
    }
    .ticket-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 0 24px 24px;
    }
    .btn {
      padding: 10px 16px;
      border-radius: 10px;
      text-decoration: none;
      border: 1px solid #cbd5e1;
      color: #0f172a;
      font-weight: 700;
      background: #ffffff;
    }
    .btn-primary {
      background: #059669;
      border-color: #059669;
      color: #ffffff;
    }
    @media print {
      body {
        background: #ffffff;
        padding: 0;
      }
      .ticket-actions {
        display: none;
      }
      .ticket-shell {
        box-shadow: none;
        border: none;
      }
    }
    @media (max-width: 700px) {
      .ticket-grid {
        grid-template-columns: 1fr;
      }
      .ticket-head {
        flex-direction: column;
      }
      .ticket-actions {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="ticket-shell">
    <div class="ticket-head">
      <div>
        <h1>TouristiX Travel Ticket</h1>
        <div><strong><%= ticket.item_name %></strong></div>
        <div style="margin-top:6px; opacity:0.92;">Issued for <%= ticket.user_name %></div>
      </div>
      <div class="ticket-chip"><%= ticket.ticket_number %></div>
    </div>

    <div class="ticket-body">
      <div class="ticket-grid">
        <div class="ticket-card">
          <h3>Booking Summary</h3>
          <div class="ticket-row"><span>Booking Type</span><strong><%= ticket.type.toUpperCase() %></strong></div>
          <div class="ticket-row"><span>Status</span><strong><%= ticket.status %></strong></div>
          <div class="ticket-row"><span>Travel Date</span><strong><%= ticket.check_in || '-' %></strong></div>
          <div class="ticket-row"><span>Check-out</span><strong><%= ticket.check_out || '-' %></strong></div>
          <div class="ticket-row"><span>Persons</span><strong><%= ticket.persons || 1 %></strong></div>
          <div class="ticket-row"><span>Seats</span><strong><%= ticket.seat_numbers || '-' %></strong></div>
        </div>

        <div class="ticket-card">
          <h3>Payment Details</h3>
          <div class="ticket-row"><span>Gateway For</span><strong><%= ticket.paymentInfo?.serviceLabel || '-' %></strong></div>
          <div class="ticket-row"><span>Merchant</span><strong><%= ticket.paymentInfo?.merchantName || '-' %></strong></div>
          <div class="ticket-row"><span>Merchant Number</span><strong><%= ticket.paymentInfo?.merchantNumber || '-' %></strong></div>
          <div class="ticket-row"><span>Amount</span><strong>BDT <%= Number(ticket.total_price || 0).toLocaleString() %></strong></div>
          <div class="ticket-row"><span>Coupon</span><strong><%= ticket.coupon_code || '-' %></strong></div>
          <div class="ticket-row"><span>Discount Saved</span><strong>BDT <%= Number(ticket.coupon_discount || 0).toLocaleString() %></strong></div>
          <div class="ticket-row"><span>Payment Method</span><strong><%= ticket.paymentInfo?.paymentLabel || String(ticket.payment_method || 'N/A').toUpperCase() %></strong></div>
          <div class="ticket-row"><span>Gateway Ref</span><strong><%= ticket.payment_gateway_ref || '-' %></strong></div>
          <div class="ticket-row"><span>Paid At</span><strong><%= ticket.paid_at || ticket.created_at || '-' %></strong></div>
          <div class="ticket-row"><span>Escrow</span><strong><%= ticket.escrow_status || '-' %></strong></div>
          <div class="ticket-row"><span>Booking ID</span><strong>#<%= ticket.id %></strong></div>
        </div>
      </div>

      <div class="ticket-grid">
        <div class="ticket-card">
          <h3>Primary Traveler</h3>
          <div class="ticket-row"><span>Name</span><strong><%= ticket.user_name %></strong></div>
          <div class="ticket-row"><span>Email</span><strong><%= ticket.user_email || '-' %></strong></div>
          <div class="ticket-row"><span>Phone</span><strong><%= ticket.user_phone || '-' %></strong></div>
        </div>

        <div class="ticket-card">
          <h3>Trip Notes</h3>
          <div style="font-size:14px; line-height:1.6; color:#334155;">
            <%= ticket.notes || 'Carry a valid ID and reach the boarding or check-in point early. Keep this ticket with you during the trip.' %>
          </div>
        </div>
      </div>

      <div class="ticket-card">
        <h3>Co-Travelers</h3>
        <% if (!ticket.coTravelers || ticket.coTravelers.length === 0) { %>
          <div style="font-size:14px; color:#64748b;">No co-traveler details were added for this booking.</div>
        <% } else { %>
          <div class="traveler-list">
            <% ticket.coTravelers.forEach((traveler, index) => { %>
              <div class="traveler-item">
                <div class="ticket-row"><span>Traveler</span><strong><%= index + 1 %>. <%= traveler.name || 'Unnamed traveler' %></strong></div>
                <div class="ticket-row"><span>Age</span><strong><%= traveler.age || '-' %></strong></div>
                <div class="ticket-row"><span>Gender</span><strong><%= traveler.gender || '-' %></strong></div>
                <div class="ticket-row"><span>Phone</span><strong><%= traveler.phone || '-' %></strong></div>
                <div class="ticket-row"><span>Relation</span><strong><%= traveler.relation || '-' %></strong></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="ticket-actions">
      <a href="/dashboard" class="btn">Back to Dashboard</a>
      <button type="button" class="btn btn-primary" onclick="window.print()">Save or Print Ticket</button>
    </div>
  </div>
</body>
</html>
