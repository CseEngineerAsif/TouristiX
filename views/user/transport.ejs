<%- include('../partials/header') %>

<section class="page-header">
  <div class="container">
    <h1><i class="fas fa-bus"></i> Transport Booking</h1>
    <p>Book buses, trains, flights and more</p>
  </div>
</section>

<style>
.transport-page .filter-form {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) auto auto;
  gap: 12px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 14px;
  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.06);
}
.transport-page .filter-form input,
.transport-page .filter-form select {
  border-radius: 10px;
}
.transport-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10px 0 18px;
  gap: 10px;
  flex-wrap: wrap;
}
.transport-toolbar .wallet-badge {
  background: #ecfdf3;
  color: #047857;
  border: 1px solid #a7f3d0;
  padding: 8px 14px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.9rem;
}
.section-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 6px 0 16px;
}
.section-tab {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  color: #0f172a;
  padding: 8px 14px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.section-tab.active {
  background: #059669;
  color: #ffffff;
  border-color: #047857;
  box-shadow: 0 10px 20px rgba(5, 150, 105, 0.2);
}
.section-tab .count {
  background: rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 2px 8px;
  font-size: 0.7rem;
}
.section-panel { display: none; }
.section-panel.active { display: block; }
.transport-list {
  display: grid;
  gap: 18px;
}
.transport-card.enhanced {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 16px 18px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.transport-card.enhanced:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 34px rgba(5, 150, 105, 0.12);
  border-color: #a7f3d0;
}
.transport-card.enhanced .transport-icon {
  background: #ecfdf3;
  padding: 10px;
  border-radius: 14px;
  min-width: 90px;
}
.transport-card.enhanced .transport-route {
  gap: 10px;
}
.transport-card.enhanced .route-from,
.transport-card.enhanced .route-to {
  font-size: 1rem;
  color: #0f172a;
}
.transport-meta {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 6px;
}
.transport-pill {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 700;
}
.transport-pill.available {
  background: #ecfdf3;
  color: #047857;
  border-color: #a7f3d0;
}
.transport-card.enhanced .transport-price {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  padding: 12px;
  border-radius: 12px;
  min-width: 140px;
  text-align: right;
}
.transport-card.enhanced .price {
  color: #059669;
}
@media (max-width: 980px) {
  .transport-page .filter-form {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 680px) {
  .transport-page .filter-form {
    grid-template-columns: 1fr;
  }
  .transport-card.enhanced {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .transport-card.enhanced .transport-price {
    width: 100%;
    text-align: left;
  }
}
</style>

<section class="section">
  <div class="container transport-page">
    <% const listReturn = '/transport'
      + (locals.from ? ('?from=' + encodeURIComponent(locals.from)) : '')
      + (locals.to ? (locals.from ? '&' : '?') + ('to=' + encodeURIComponent(locals.to)) : '')
      + (locals.type ? ((locals.from || locals.to) ? '&' : '?') + ('type=' + encodeURIComponent(locals.type)) : '');
    %>
    <% if (locals.success_msg && success_msg.length) { %>
      <div class="alert alert-success"><%= success_msg[0] %></div>
    <% } %>
    <% if (locals.error_msg && error_msg.length) { %>
      <div class="alert alert-danger"><%= error_msg[0] %></div>
    <% } %>

    <form action="/transport" method="GET" class="filter-form">
      <input type="text" name="from" placeholder="From (e.g. Dhaka)" value="<%= locals.from || '' %>"/>
      <input type="text" name="to" placeholder="To (e.g. Cox's Bazar)" value="<%= locals.to || '' %>"/>
      <select name="type">
        <option value="">All Types</option>
        <% ['Bus','Train','Air','Launch'].forEach(t => { %>
        <option value="<%= t %>" <%= locals.type===t?'selected':'' %>><%= t %></option>
        <% }) %>
      </select>
      <% if (locals.returnTo) { %>
      <input type="hidden" name="return" value="<%= returnTo %>"/>
      <% } %>
      <button type="submit" class="btn-primary"><i class="fas fa-search"></i> Search</button>
      <a href="/transport<%= returnTo ? ('?return=' + encodeURIComponent(returnTo)) : '' %>" class="btn-outline">Clear</a>
    </form>

    <% if (locals.user) { %>
      <div class="transport-toolbar">
        <div class="wallet-badge">Wallet Balance: BDT <%= (walletBalance || 0).toLocaleString() %></div>
      </div>

      <div class="section-tabs" id="transportTabs">
        <button type="button" class="section-tab active" data-target="panel-available">
          Available Tickets <span class="count"><%= (transports || []).length %></span>
        </button>
        <button type="button" class="section-tab" data-target="panel-tickets">
          My Tickets <span class="count"><%= (myTransportTickets || []).length %></span>
        </button>
        <button type="button" class="section-tab" data-target="panel-incoming">
          Incoming Requests <span class="count"><%= (incomingExchangeRequests || []).length %></span>
        </button>
        <button type="button" class="section-tab" data-target="panel-released">
          Released Exchange <span class="count"><%= (releasedTickets || []).length %></span>
        </button>
        <button type="button" class="section-tab" data-target="panel-myrequests">
          My Requests <span class="count"><%= (myExchangeRequests || []).length %></span>
        </button>
      </div>

      <div class="exchange-section section-panel" id="panel-tickets">
        <div class="exchange-title-row">
          <h3><i class="fas fa-ticket"></i> My Transport Tickets</h3>
          <small>Only admin-confirmed tickets can be released. Exchange window: within 3 days and before 3 hours of departure.</small>
        </div>

        <% if ((myTransportTickets || []).length === 0) { %>
          <p class="exchange-empty">No active transport tickets found.</p>
        <% } else { %>
          <div class="ticket-exchange-list">
            <% myTransportTickets.forEach(ticket => { %>
              <div class="ticket-exchange-card">
                <div>
                  <h4><%= ticket.item_name %></h4>
                  <p><strong>Status:</strong> <%= ticket.status %> <%= ticket.exchange_locked ? '(Exchanged Ticket)' : '' %></p>
                  <p><i class="fas fa-calendar"></i> Travel date: <%= ticket.check_in %></p>
                  <p><i class="fas fa-clock"></i> Departure: <%= ticket.departure_time %></p>
                  <p><i class="fas fa-users"></i> <%= ticket.persons %> ticket(s)</p>
                </div>
                <div class="ticket-exchange-actions">
                  <span class="booking-price">BDT <%= (ticket.total_price || 0).toLocaleString() %></span>
                  <% if (ticket.status === 'confirmed' && !ticket.exchange_locked) { %>
                    <form action="/bookings/<%= ticket.id %>/release-ticket" method="POST">
                      <button
                        type="submit"
                        class="btn-danger-sm"
                        <%= ticket.exchange_open ? '' : 'disabled' %>
                        onclick="return confirm('Release this ticket for exchange?')"
                      >
                        Release Ticket
                      </button>
                    </form>
                  <% } %>
                  <% if (!ticket.exchange_open && ticket.status === 'confirmed') { %>
                    <small class="muted-text">Release window closed</small>
                  <% } %>
                  <% if (ticket.status === 'pending') { %>
                    <small class="muted-text">Waiting for admin confirmation</small>
                  <% } %>
                  <% if (ticket.status === 'released') { %>
                    <small class="muted-text">Waiting for your approval on incoming requests</small>
                  <% } %>
                  <% if (ticket.exchange_locked) { %>
                    <small class="muted-text">You cannot release/cancel this exchanged ticket</small>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="exchange-section section-panel" id="panel-incoming">
        <div class="exchange-title-row">
          <h3><i class="fas fa-user-check"></i> Incoming Exchange Requests</h3>
          <small>Only ticket owner can accept or reject request.</small>
        </div>

        <% if ((incomingExchangeRequests || []).length === 0) { %>
          <p class="exchange-empty">No incoming requests for your released tickets.</p>
        <% } else { %>
          <div class="ticket-exchange-list">
            <% incomingExchangeRequests.forEach(r => { %>
              <div class="ticket-exchange-card">
                <div>
                  <h4><%= r.item_name %></h4>
                  <p><i class="fas fa-user"></i> Requested by: <%= r.requester_name %></p>
                  <p><i class="fas fa-route"></i> <%= r.from_location %> to <%= r.to_location %></p>
                  <p><i class="fas fa-calendar"></i> Travel date: <%= r.check_in %></p>
                  <p><i class="fas fa-clock"></i> Departure: <%= r.departure_time %></p>
                  <p><strong>Held Payment:</strong> BDT <%= (r.amount || 0).toLocaleString() %></p>
                </div>
                <div class="ticket-exchange-actions">
                  <form action="/exchange-requests/<%= r.id %>/accept" method="POST">
                    <button type="submit" class="btn-sm" onclick="return confirm('Accept this exchange request?')">Accept</button>
                  </form>
                  <form action="/exchange-requests/<%= r.id %>/reject" method="POST">
                    <button type="submit" class="btn-danger-sm" onclick="return confirm('Reject this exchange request?')">Reject</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="exchange-section section-panel" id="panel-released">
        <div class="exchange-title-row">
          <h3><i class="fas fa-right-left"></i> Released Tickets Exchange</h3>
          <small>Claim only within 3 days and before 3 hours of departure.</small>
        </div>

        <% if ((releasedTickets || []).length === 0) { %>
          <p class="exchange-empty">No released tickets available right now.</p>
        <% } else { %>
          <div class="ticket-exchange-list">
            <% releasedTickets.forEach(ticket => { %>
              <div class="ticket-exchange-card">
                <div>
                  <h4><%= ticket.item_name %></h4>
                  <p><i class="fas fa-route"></i> <%= ticket.from_location %> to <%= ticket.to_location %></p>
                  <p><i class="fas fa-calendar"></i> Travel date: <%= ticket.check_in %></p>
                  <p><i class="fas fa-clock"></i> Departure: <%= ticket.departure_time %></p>
                  <p><i class="fas fa-users"></i> <%= ticket.persons %> ticket(s)</p>
                </div>
                <div class="ticket-exchange-actions">
                  <span class="booking-price">BDT <%= (ticket.total_price || 0).toLocaleString() %></span>
                  <form action="/tickets/<%= ticket.id %>/request-exchange" method="POST">
                    <button
                      type="submit"
                      class="btn-sm"
                      <%= (ticket.exchange_open && !ticket.already_requested) ? '' : 'disabled' %>
                      onclick="return confirm('Send exchange request for this ticket?')"
                    >
                      Request Ticket
                    </button>
                  </form>
                  <% if (ticket.already_requested) { %>
                    <small class="muted-text">Request already submitted (payment held)</small>
                  <% } else if (!ticket.exchange_open) { %>
                    <small class="muted-text">Claim window closed</small>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="exchange-section section-panel" id="panel-myrequests">
        <div class="exchange-title-row">
          <h3><i class="fas fa-receipt"></i> My Exchange Requests</h3>
          <small>Track accepted/rejected requests and payment state.</small>
        </div>

        <% if ((myExchangeRequests || []).length === 0) { %>
          <p class="exchange-empty">No exchange requests submitted yet.</p>
        <% } else { %>
          <div class="ticket-exchange-list">
            <% myExchangeRequests.forEach(r => { %>
              <div class="ticket-exchange-card">
                <div>
                  <h4><%= r.item_name %></h4>
                  <p><i class="fas fa-user"></i> Owner: <%= r.owner_name %></p>
                  <p><i class="fas fa-route"></i> <%= r.from_location %> to <%= r.to_location %></p>
                  <p><strong>Status:</strong> <%= r.status %></p>
                  <p><strong>Payment:</strong> <%= r.payment_status %> (BDT <%= (r.amount || 0).toLocaleString() %>)</p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="section-panel active" id="panel-available">
      <div class="transport-list">
        <% transports.forEach(t => { %>
        <div class="transport-card enhanced">
          <div class="transport-icon">
            <% if(t.type==='Bus') { %><i class="fas fa-bus"></i>
            <% } else if(t.type==='Train') { %><i class="fas fa-train"></i>
            <% } else if(t.type==='Air') { %><i class="fas fa-plane"></i>
            <% } else { %><i class="fas fa-ship"></i><% } %>
            <span class="transport-type"><%= t.type %></span>
          </div>
          <div class="transport-route">
            <div class="route-from"><strong><%= t.from_location %></strong></div>
            <div class="route-arrow"><i class="fas fa-long-arrow-alt-right"></i></div>
            <div class="route-to"><strong><%= t.to_location %></strong></div>
          </div>
          <div class="transport-info">
            <p><i class="fas fa-building"></i> <%= t.company %></p>
            <p><i class="fas fa-clock"></i> Departs: <%= t.departure_time %></p>
            <div class="transport-meta">
              <span class="transport-pill available"><i class="fas fa-chair"></i> <%= t.seats_available %> seats left</span>
              <span class="transport-pill"><i class="fas fa-calendar-alt"></i> Daily</span>
            </div>
          </div>
          <div class="transport-price">
            <div class="price">BDT <%= t.price %></div>
            <div class="price-label">per person</div>
            <% if (locals.user) { %>
            <a href="/transport/<%= t.id %>?return=<%= encodeURIComponent(listReturn) %>" class="btn-sm">View Details</a>
            <% } else { %>
            <a href="/auth/login" class="btn-sm">Login</a>
            <% } %>
          </div>
        </div>
        <% }) %>
        <% if (transports.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-search"></i>
          <h3>No transport found</h3>
          <p>Try different search parameters</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
const tabWrap = document.getElementById('transportTabs');
if (tabWrap) {
  tabWrap.addEventListener('click', (e) => {
    const btn = e.target.closest('.section-tab');
    if (!btn) return;
    const targetId = btn.getAttribute('data-target');
    document.querySelectorAll('.section-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.section-panel').forEach(p => p.classList.remove('active'));
    const panel = document.getElementById(targetId);
    if (panel) panel.classList.add('active');
  });
}
</script>
<%- include('../partials/footer') %>
