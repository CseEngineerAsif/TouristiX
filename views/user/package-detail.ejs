<%- include('../partials/header') %>

<section class="page-header">
  <div class="container">
    <a href="/packages" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Packages</a>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="detail-layout">
      <div class="detail-main">
        <div class="detail-hero">
          <img src="<%= pkg.image %>" alt="<%= pkg.name %>" onerror="this.src='/images/placeholder.jpg'"/>
          <div class="detail-hero-overlay">
            <span class="card-badge">Package</span>
            <div class="detail-rating"><i class="fas fa-money-bill-wave"></i> ৳<%= pkg.price.toLocaleString() %> / person</div>
          </div>
        </div>

        <div class="detail-info">
          <div class="detail-info-header">
            <div>
              <h1><%= pkg.name %></h1>
              <p class="detail-location"><i class="fas fa-map-marker-alt"></i> <%= pkg.destination %></p>
            </div>
            <% if (locals.user) { %>
            <button class="btn-primary" onclick="openPkgBook('<%= pkg.id %>','<%= pkg.name.replace(/'/g,'') %>',<%= pkg.price %>)">
              <i class="fas fa-suitcase"></i> Book Package
            </button>
            <% } else { %>
            <a href="/auth/login" class="btn-primary">Login to Book</a>
            <% } %>
          </div>

          <div class="info-pills">
            <span><i class="fas fa-clock"></i> Duration: <%= pkg.duration || 'N/A' %></span>
            <span><i class="fas fa-users"></i> Max Persons: <%= pkg.max_persons || 'N/A' %></span>
            <span><i class="fas fa-tag"></i> Price: ৳<%= pkg.price.toLocaleString() %> per person</span>
          </div>

          <p class="detail-desc"><%= pkg.description %></p>

          <div class="reviews-section">
            <h2><i class="fas fa-check-circle"></i> What's Included</h2>
            <div class="pkg-includes-grid">
              <% (pkg.includes || '').split(',').map(s => s.trim()).filter(Boolean).forEach(inc => { %>
              <span class="include-item"><i class="fas fa-check"></i> <%= inc %></span>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="sidebar-block">
          <div class="sidebar-head">
            <h3><i class="fas fa-suitcase"></i> Related Packages</h3>
            <a href="/packages">View all</a>
          </div>
          <% if (!relatedPackages.length) { %>
          <p class="sidebar-empty">No related packages available.</p>
          <% } %>
          <% relatedPackages.forEach(p => { %>
          <div class="sidebar-item">
            <div class="sidebar-item-top">
              <strong><%= p.name %></strong>
              <span>৳<%= p.price.toLocaleString() %></span>
            </div>
            <p><i class="fas fa-map-marker-alt"></i> <%= p.destination %></p>
            <div class="sidebar-item-actions">
              <span><i class="fas fa-clock"></i> <%= p.duration %></span>
              <a href="/packages/<%= p.id %>" class="btn-sm">View</a>
            </div>
          </div>
          <% }) %>
        </div>
      </aside>
    </div>
  </div>
</section>

<div id="pkgModal" class="modal" style="display:none">
  <div class="modal-box">
    <div class="modal-header">
      <h3>Book Package</h3>
      <button onclick="document.getElementById('pkgModal').style.display='none'" class="modal-close">&times;</button>
    </div>
    <form action="/book/package" method="POST" class="modal-form js-payment-form" data-booking-kind="package">
      <input type="hidden" name="pkg_id" id="pk_id"/>
      <input type="hidden" name="pkg_name" id="pk_name_hidden"/>
      <input type="hidden" name="total_price" id="pk_total"/>
      <div class="form-group">
        <label>Package</label>
        <input type="text" id="pk_display" readonly class="form-control"/>
      </div>
      <div class="form-group">
        <label>Travel Date</label>
        <input type="date" name="travel_date" class="form-control" required/>
      </div>
      <div class="form-group">
        <label>Number of Persons</label>
        <input type="number" name="persons" id="pk_persons" value="1" min="1" max="20" class="form-control" oninput="calcPkgPrice()"/>
      </div>
      <div class="price-display" id="pkPriceDisplay"></div>
      <button type="submit" class="btn-primary btn-block">Confirm Booking</button>
    </form>
  </div>
</div>

<script>
let pkPrice = 0;
const today = new Date().toISOString().split('T')[0];
document.querySelector('[name="travel_date"]').min = today;
function openPkgBook(id, name, price) {
  pkPrice = price;
  document.getElementById('pk_id').value = id;
  document.getElementById('pk_name_hidden').value = name;
  document.getElementById('pk_display').value = name;
  document.getElementById('pkgModal').style.display = 'flex';
  calcPkgPrice();
}
function calcPkgPrice() {
  const p = parseInt(document.getElementById('pk_persons').value) || 1;
  const total = p * pkPrice;
  document.getElementById('pk_total').value = total;
  document.getElementById('pkPriceDisplay').innerHTML = `৳${pkPrice.toLocaleString()} x ${p} person(s) = <strong>৳${total.toLocaleString()}</strong>`;
}
</script>

<%- include('../partials/payment-modal') %>
<%- include('../partials/footer') %>
