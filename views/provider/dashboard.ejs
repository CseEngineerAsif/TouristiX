.partner-intro p {
  position: relative;
  margin: 0;
  max-width: 640px;
  color: #5f7384;
  line-height: 1.7;
}
.partner-top-summary {
  background:
    radial-gradient(circle at top right, rgba(34, 197, 94, 0.14), transparent 28%),
    linear-gradient(135deg, #0f766e, #14532d 70%, #134e4a);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 28px;
  padding: 22px;
