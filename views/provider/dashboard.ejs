<%- include('../partials/header') %>

<section class="dashboard">
  <div class="dashboard-header">
    <h2><i class="fas fa-briefcase"></i> Partner Dashboard</h2>
    <p class="muted-text">Manage your listings and confirm completed services.</p>
  </div>

  <% if (locals.success_msg && success_msg.length) { %>
    <div class="alert alert-success"><%= success_msg[0] %></div>
  <% } %>
  <% if (locals.error_msg && error_msg.length) { %>
    <div class="alert alert-danger"><%= error_msg[0] %></div>
  <% } %>

  <div class="dashboard-grid">
    <div class="dashboard-card">
      <h3><i class="fas fa-store"></i> My Listings</h3>
      <% if (!items || items.length === 0) { %>
        <p class="muted-text">No listings assigned yet. Please contact admin to assign your listings.</p>
      <% } else { %>
        <ul class="simple-list">
          <% items.forEach(item => { %>
            <li>
              <strong><%= item.name || item.company || item.type %></strong>
              <span class="muted-text">ID: <%= item.id %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="dashboard-card">
      <h3><i class="fas fa-calendar-check"></i> Bookings</h3>
      <% if (!bookings || bookings.length === 0) { %>
        <p class="muted-text">No bookings yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Item</th>
                <th>Date</th>
                <th>Persons</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Escrow</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% bookings.forEach((b, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= b.item_name || '-' %></td>
                  <td><%= b.check_in || '-' %></td>
                  <td><%= b.persons || 1 %></td>
                  <td>BDT <%= (b.total_price || 0).toLocaleString() %></td>
                  <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
                  <td><small><%= b.escrow_status || 'held' %></small></td>
                  <td>
                    <% if (b.status !== 'completed') { %>
                      <form action="/provider/bookings/<%= b.id %>/complete" method="POST">
                        <button type="submit" class="btn-sm">Mark Completed</button>
                      </form>
                    <% } else { %>
                      <small class="text-muted">Completed</small>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
