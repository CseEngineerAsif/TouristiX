}
.partner-grid {
  display: grid;
  grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}
.panel-card {
  background: linear-gradient(180deg, #ffffff, #fbfdff);
  border: 1px solid #dce8f3;
  border-radius: 28px;
  padding: 22px;
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.05);
}
.panel-card h3 {
  margin: 0 0 8px;
  color: #102a43;
}
.panel-card p {
  margin: 0;
}
.listing-stack,
.booking-stack {
  display: grid;
  gap: 16px;
}
.listing-item {
  border: 1px solid #d8e6f2;
