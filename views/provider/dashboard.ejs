<%- include('../partials/header') %>

<%
  const allBookings = bookings || [];
  const allItems = items || [];
  const totalBookings = allBookings.length;
  const activeBookings = allBookings.filter(b => b.status !== 'cancelled' && b.status !== 'completed').length;
  const completedBookings = allBookings.filter(b => b.status === 'completed').length;
  const pendingBookings = allBookings.filter(b => b.status === 'pending').length;
  const totalProjectedPayout = allBookings.reduce((sum, b) => (
    sum + (String(b.escrow_status || '').toLowerCase() === 'refunded'
      ? 0
      : Math.max(0, Number(b.total_price || 0) - Number(b.provider_commission_amount || 0)))
  ), 0);

  function providerLabel(type) {
    if (type === 'hotel') return 'Hotel Partner';
    if (type === 'transport') return 'Transport Partner';
    if (type === 'guide') return 'Guide Partner';
    if (type === 'package') return 'Package Partner';
    return 'Partner';
  }

  function prettyStatus(status) {
    const value = String(status || 'unknown');
    return value.charAt(0).toUpperCase() + value.slice(1);
  }
%>

<style>
.partner-shell {
  display: grid;
  gap: 22px;
  padding: 18px 0 28px;
  background:
    radial-gradient(circle at top left, rgba(14, 165, 233, 0.08), transparent 22%),
    radial-gradient(circle at top right, rgba(34, 197, 94, 0.08), transparent 18%);
}
.partner-topbar {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.8fr);
  gap: 18px;
  align-items: stretch;
}
.partner-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 999px;
  background: linear-gradient(180deg, #fff7ed, #ffedd5);
