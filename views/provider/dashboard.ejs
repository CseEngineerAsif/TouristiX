  color: #102a43;
  font-size: 1.1rem;
}
.booking-subtitle {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 12px;
  color: #66788a;
  font-size: 0.92rem;
}
.booking-subtitle span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.soft-pill,
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
