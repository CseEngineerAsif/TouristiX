  background:
    linear-gradient(180deg, #ffffff, #f9fcff);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
}
.listing-item strong {
  display: block;
  color: #102a43;
}
.listing-meta {
  margin-top: 8px;
