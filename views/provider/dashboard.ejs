  .booking-head {
    flex-direction: column;
    align-items: stretch;
  }
  .text-button {
    width: 100%;
  }
  .customer-modal-card {
    padding: 18px;
    border-radius: 20px;
  }
}
</style>

<section class="partner-shell">
  <div class="partner-topbar">
    <div class="partner-intro">
        <span class="partner-kicker"><i class="fas fa-briefcase"></i> <%= providerLabel(providerType) %></span>
        <h2>Partner Dashboard</h2>
        <p>Review bookings, track instantly-settled payout numbers, and open customer information from a simpler and more polished workspace.</p>
    </div>
    <div class="partner-top-summary">
      <div>
        <div class="summary-label">Paid or expected payout</div>
        <div class="summary-value">BDT <%= totalProjectedPayout.toLocaleString() %></div>
      </div>
      <div class="summary-inline">
        <div class="summary-chip">
          <span>Listings</span>
          <strong><%= allItems.length %></strong>
        </div>
        <div class="summary-chip">
          <span>Customers</span>
          <strong><%= totalBookings %></strong>
        </div>
      </div>
    </div>
  </div>

  <% if (locals.success_msg && success_msg.length) { %>
    <div class="alert alert-success"><%= success_msg[0] %></div>
  <% } %>
  <% if (locals.error_msg && error_msg.length) { %>
    <div class="alert alert-danger"><%= error_msg[0] %></div>
  <% } %>

  <div class="partner-stats">
    <div class="partner-stat">
      <div class="label">Total bookings</div>
      <strong><%= totalBookings %></strong>
    </div>
    <div class="partner-stat">
      <div class="label">Active now</div>
      <strong><%= activeBookings %></strong>
    </div>
    <div class="partner-stat">
      <div class="label">Pending review</div>
      <strong><%= pendingBookings %></strong>
    </div>
    <div class="partner-stat">
      <div class="label">Completed</div>
      <strong><%= completedBookings %></strong>
    </div>
  </div>

  <div class="partner-grid">
    <aside class="panel-card">
      <h3><i class="fas fa-store"></i> My Listings</h3>
      <p class="muted-text">Everything assigned to your partner account appears here.</p>

      <div class="listing-stack" style="margin-top:16px;">
        <% if (!allItems.length) { %>
          <div class="empty-state">
            No listings are assigned yet. Please contact admin to connect your partner account.
          </div>
        <% } else { %>
          <% allItems.forEach(item => { %>
            <div class="listing-item">
              <strong><%= item.name || item.company || item.type || 'Listing' %></strong>
              <div class="listing-meta">
                Listing ID: <%= item.id %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </aside>

    <div class="panel-card">
      <div class="booking-head">
        <div>
          <h3><i class="fas fa-calendar-check"></i> Recent Bookings</h3>
          <p>Each booking shows the split between your payout and admin commission after payment.</p>
        </div>
        <div class="pill-row">
          <span class="soft-pill"><%= providerType ? providerType.toUpperCase() : 'PARTNER' %></span>
          <span class="soft-pill"><%= totalBookings %> Bookings</span>
        </div>
      </div>

      <% if (!allBookings.length) { %>
        <div class="empty-state">
          No bookings yet.
        </div>
      <% } else { %>
        <div class="booking-stack">
          <% allBookings.forEach((b, i) => { %>
            <% const payout = Math.max(0, Number(b.total_price || 0) - Number(b.provider_commission_amount || 0)); %>
            <% const travelerPreview = b.traveler_preview || {}; %>
            <% const coTravelers = travelerPreview.co_travelers || []; %>
            <article class="booking-card">
              <div class="booking-card-top">
                <div>
                  <h4 class="booking-title"><%= b.item_name || 'Untitled Booking' %></h4>
                  <div class="booking-subtitle">
                    <span>Booking #<%= b.id %></span>
                    <span>Date: <%= b.check_in || '-' %></span>
                    <% if (b.check_out) { %><span>Checkout: <%= b.check_out %></span><% } %>
                    <% if (b.seat_numbers) { %><span>Seats: <%= b.seat_numbers %></span><% } %>
                  </div>
                </div>
                <div class="pill-row">
                  <span class="status-badge status-<%= b.status %>"><%= prettyStatus(b.status) %></span>
                  <span class="soft-pill">Settlement: <%= b.escrow_status || 'paid_out' %></span>
                </div>
              </div>

              <div class="booking-metrics">
                <div class="metric-box">
                  <span>Persons</span>
                  <strong><%= b.persons || 1 %></strong>
                </div>
                <div class="metric-box">
                  <span>Amount</span>
                  <strong>BDT <%= Number(b.total_price || 0).toLocaleString() %></strong>
                </div>
                <div class="metric-box">
                  <span>Admin Commission</span>
                  <strong>BDT <%= Number(b.provider_commission_amount || 0).toLocaleString() %></strong>
                </div>
                <div class="metric-box">
                  <span>Your Payout</span>
                  <strong>BDT <%= payout.toLocaleString() %></strong>
                </div>
              </div>

              <div class="booking-actions">
                <button
                  type="button"
                  class="text-button"
                  onclick="openCustomerModal('customer-modal-<%= i %>')"
                >
                  Customer
                </button>
              </div>
            </article>

            <div
              class="customer-modal"
              id="customer-modal-<%= i %>"
              onclick="closeCustomerModal(event, 'customer-modal-<%= i %>')"
            >
              <div class="customer-modal-card">
                <div class="customer-modal-head">
                  <div>
                    <h4>Customer Details</h4>
                    <p><%= b.item_name || 'Booking' %> | Booking #<%= b.id %></p>
                  </div>
                  <button type="button" class="modal-close" onclick="forceCloseCustomerModal('customer-modal-<%= i %>')">
                    <i class="fas fa-times"></i>
                  </button>
                </div>

                <div class="details-grid">
                  <div class="detail-cell">
                    <span>Customer name</span>
                    <strong><%= travelerPreview.customer_name || 'Unknown' %></strong>
                  </div>
                  <div class="detail-cell">
                    <span>Email</span>
                    <strong><%= travelerPreview.customer_email || 'Not provided' %></strong>
                  </div>
                  <div class="detail-cell">
                    <span>Phone</span>
                    <strong><%= travelerPreview.customer_phone || 'Not provided' %></strong>
                  </div>
                </div>

                <% if (coTravelers.length) { %>
                  <div class="traveler-list">
                    <% coTravelers.slice(0, 2).forEach((traveler, idx) => { %>
                      <div class="traveler-chip">
                        <strong>Traveler <%= idx + 2 %>: <%= traveler.name || 'Unnamed' %></strong>
                        <small>
                          <%= traveler.relation || 'Relation not set' %>
                          <% if (traveler.phone) { %> | <%= traveler.phone %><% } %>
                          <% if (traveler.gender) { %> | <%= traveler.gender %><% } %>
                          <% if (traveler.age) { %> | Age <%= traveler.age %><% } %>
                        </small>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
function openCustomerModal(id) {
  const modal = document.getElementById(id);
  if (!modal) return;
  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function forceCloseCustomerModal(id) {
  const modal = document.getElementById(id);
  if (!modal) return;
  modal.classList.remove('open');
  document.body.style.overflow = '';
}

function closeCustomerModal(event, id) {
  if (event.target.id !== id) return;
  forceCloseCustomerModal(id);
}

document.addEventListener('keydown', function(event) {
  if (event.key !== 'Escape') return;
  const openModal = document.querySelector('.customer-modal.open');
  if (openModal) {
    openModal.classList.remove('open');
    document.body.style.overflow = '';
  }
});
document.addEventListener('click', function(event) {
  if (event.target.closest('.modal-close')) {
    event.stopPropagation();
  }
});
window.addEventListener('beforeunload', function() {
  document.body.style.overflow = '';
});
</script>

<%- include('../partials/footer') %>
