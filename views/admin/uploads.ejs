<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-images"></i> Media Library</h3>
  </div>
  <form action="/admin/uploads" method="POST" enctype="multipart/form-data" class="upload-form">
    <div class="upload-zone" id="dropZone">
      <i class="fas fa-cloud-upload-alt"></i>
      <p>Drag & drop images here or click to select</p>
      <input type="file" name="images" multiple accept="image/*" id="fileInput" style="opacity:0;position:absolute;inset:0;cursor:pointer"/>
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-upload"></i> Upload Images</button>
  </form>
  <div class="media-grid">
    <% files.forEach(f => { %>
    <div class="media-item">
      <img src="<%= f.url %>" alt="<%= f.name %>"/>
      <div class="media-overlay">
        <button onclick="copyUrl('<%= f.url %>')" class="btn-sm"><i class="fas fa-copy"></i> Copy URL</button>
      </div>
    </div>
    <% }) %>
    <% if (files.length === 0) { %>
    <p class="text-muted" style="grid-column:1/-1;text-align:center;padding:40px">No images uploaded yet.</p>
    <% } %>
  </div>
</div>

<script>
function copyUrl(url) {
  navigator.clipboard.writeText(window.location.origin + url).then(() => alert('URL copied!'));
}
</script>

<%- include('./partials/admin-footer') %>
