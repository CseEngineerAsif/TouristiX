<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-pen"></i> Edit Guide</h3>
    <a href="/admin/guides" class="btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
  </div>
  <form action="/admin/guides/<%= guide.id %>/edit" method="POST" enctype="multipart/form-data" class="modal-form">
    <input type="hidden" name="current_image" value="<%= guide.image %>"/>
    <div class="form-row">
      <div class="form-group"><label>Name</label><input type="text" name="name" required class="form-control" value="<%= guide.name %>"/></div>
      <div class="form-group"><label>Specialty</label><input type="text" name="specialty" class="form-control" value="<%= guide.specialty || '' %>"/></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Languages</label><input type="text" name="languages" class="form-control" value="<%= guide.languages || '' %>"/></div>
      <div class="form-group"><label>Experience</label><input type="text" name="experience" class="form-control" value="<%= guide.experience || '' %>"/></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Rating</label><input type="number" name="rating" min="0" max="5" step="0.1" class="form-control" value="<%= guide.rating %>"/></div>
      <div class="form-group"><label>Price Per Day (BDT)</label><input type="number" name="price_per_day" class="form-control" value="<%= guide.price_per_day %>"/></div>
    </div>
    <div class="form-group"><label>Phone</label><input type="text" name="phone" class="form-control" value="<%= guide.phone || '' %>"/></div>
    <div class="form-group"><label>Bio</label><textarea name="bio" rows="4" class="form-control"><%= guide.bio || '' %></textarea></div>
    <div class="form-group"><label><input type="checkbox" name="available" <%= guide.available ? 'checked' : '' %>/> Available</label></div>
    <div class="form-group">
      <label>Current Image</label>
      <img src="<%= guide.image %>" alt="" style="width:200px;height:120px;object-fit:cover;border-radius:10px;border:1px solid #ddd" onerror="this.src='/images/placeholder.jpg'"/>
    </div>
    <div class="form-group"><label>Upload New Image</label><input type="file" name="image" accept="image/*" class="form-control"/></div>
    <button type="submit" class="btn-primary">Update Guide</button>
  </form>
</div>

<%- include('./partials/admin-footer') %>
