<%- include('./partials/admin-header') %>

<div class="stats-grid">
  <div class="stat-card stat-blue">
    <div class="stat-icon"><i class="fas fa-users"></i></div>
    <div class="stat-info"><div class="stat-number"><%= stats.users %></div><div class="stat-label">Total Users</div></div>
  </div>
  <div class="stat-card stat-green">
    <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
    <div class="stat-info"><div class="stat-number"><%= stats.bookings %></div><div class="stat-label">Total Bookings</div></div>
  </div>
  <div class="stat-card stat-orange">
    <div class="stat-icon"><i class="fas fa-map-marker-alt"></i></div>
    <div class="stat-info"><div class="stat-number"><%= stats.spots %></div><div class="stat-label">Tourist Spots</div></div>
  </div>
  <div class="stat-card stat-red">
    <div class="stat-icon"><i class="fas fa-clock"></i></div>
    <div class="stat-info"><div class="stat-number"><%= stats.pending %></div><div class="stat-label">Pending Bookings</div></div>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-history"></i> Recent Bookings</h3>
    <a href="/admin/bookings" class="btn-sm">View All</a>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>User</th><th>Type</th><th>Item</th><th>Date</th><th>Amount</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% recentBookings.forEach(b => { %>
        <tr>
          <td><%= b.user_name %></td>
          <td><span class="badge badge-<%= b.type %>"><%= b.type %></span></td>
          <td><%= b.item_name %></td>
          <td><%= new Date(b.created_at).toLocaleDateString() %></td>
          <td>৳<%= (b.total_price||0).toLocaleString() %></td>
          <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
        </tr>
        <% }) %>
        <% if (recentBookings.length === 0) { %>
        <tr><td colspan="6" class="text-center">No bookings yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="quick-actions">
  <h3>Quick Actions</h3>
  <div class="quick-actions-grid">
    <a href="/admin/spots" class="qa-card"><i class="fas fa-plus"></i> Add Tourist Spot</a>
    <a href="/admin/hotels" class="qa-card"><i class="fas fa-hotel"></i> Add Hotel</a>
    <a href="/admin/guides" class="qa-card"><i class="fas fa-user-tie"></i> Add Guide</a>
    <a href="/admin/packages" class="qa-card"><i class="fas fa-box-open"></i> Add Package</a>
    <a href="/admin/uploads" class="qa-card"><i class="fas fa-upload"></i> Upload Images</a>
    <a href="/admin/bookings" class="qa-card"><i class="fas fa-tasks"></i> Manage Bookings</a>
  </div>
</div>

<%- include('./partials/admin-footer') %>
