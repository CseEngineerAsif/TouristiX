<%- include('./partials/admin-header') %>

<div class="admin-card" style="max-width:700px">
  <div class="admin-card-header">
    <h3><i class="fas fa-edit"></i> Edit Tourist Spot</h3>
    <a href="/admin/spots" class="btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
  </div>
  <form action="/admin/spots/<%= spot.id %>/edit" method="POST" enctype="multipart/form-data" class="modal-form" style="padding:0">
    <input type="hidden" name="current_image" value="<%= spot.image %>"/>
    <div class="form-row">
      <div class="form-group"><label>Name</label><input type="text" name="name" value="<%= spot.name %>" required class="form-control"/></div>
      <div class="form-group"><label>District</label><input type="text" name="district" value="<%= spot.district %>" required class="form-control"/></div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Division</label>
        <select name="division" class="form-control">
          <% ['Chittagong','Dhaka','Sylhet','Khulna','Rajshahi','Barisal','Rangpur','Mymensingh'].forEach(d => { %>
          <option value="<%= d %>" <%= spot.division===d?'selected':'' %>><%= d %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category" class="form-control">
          <% ['Beach','Hill','Forest','Heritage','Island','Garden','Lake','River'].forEach(c => { %>
          <option value="<%= c %>" <%= spot.category===c?'selected':'' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="form-group"><label>Description</label><textarea name="description" rows="4" class="form-control desc-justify"><%= spot.description %></textarea></div>
    <div class="form-row">
      <div class="form-group"><label>Entry Fee (৳)</label><input type="number" name="entry_fee" value="<%= spot.entry_fee %>" class="form-control"/></div>
      <div class="form-group"><label>Best Time</label><input type="text" name="best_time" value="<%= spot.best_time %>" class="form-control"/></div>
    </div>
    <% if (spot.image) { %><div class="current-img"><img src="<%= spot.image %>" alt="" style="height:80px;border-radius:8px"/><p>Current image</p></div><% } %>
    <div class="form-group"><label>Upload New Image</label><input type="file" name="image" accept="image/*" class="form-control"/></div>
    <button type="submit" class="btn-primary btn-block">Save Changes</button>
  </form>
</div>

<%- include('./partials/admin-footer') %>
