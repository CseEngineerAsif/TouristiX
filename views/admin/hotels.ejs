<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-hotel"></i> Hotels</h3>
    <button class="btn-primary" onclick="document.getElementById('addHotelModal').style.display='flex'"><i class="fas fa-plus"></i> Add Hotel</button>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Image</th><th>Name</th><th>Location</th><th>Price/Night</th><th>Rating</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% hotels.forEach(h => { %>
        <tr>
          <td><img src="<%= h.image %>" alt="" style="width:60px;height:40px;object-fit:cover;border-radius:8px" onerror="this.src='/images/placeholder.jpg'"/></td>
          <td><strong><%= h.name %></strong></td>
          <td><%= h.location %></td>
          <td>BDT <%= (h.price_per_night || 0).toLocaleString() %></td>
          <td><i class="fas fa-star" style="color:#f59e0b"></i> <%= h.rating %></td>
          <td>
            <a href="/admin/hotels/<%= h.id %>/edit" class="btn-sm"><i class="fas fa-pen"></i></a>
            <form action="/admin/hotels/<%= h.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
              <button type="submit" class="btn-danger-sm"><i class="fas fa-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="addHotelModal" class="modal" style="display:none">
  <div class="modal-box modal-lg">
    <div class="modal-header">
      <h3>Add Hotel</h3>
      <button onclick="document.getElementById('addHotelModal').style.display='none'" class="modal-close">&times;</button>
    </div>
    <form action="/admin/hotels/add" method="POST" enctype="multipart/form-data" class="modal-form">
      <div class="form-row">
        <div class="form-group"><label>Hotel Name</label><input type="text" name="name" required class="form-control"/></div>
        <div class="form-group"><label>District</label><input type="text" name="district" required class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Location/Area</label><input type="text" name="location" required class="form-control"/></div>
        <div class="form-group"><label>Price/Night (BDT)</label><input type="number" name="price_per_night" required class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Rating</label><input type="number" name="rating" min="0" max="5" step="0.1" value="0" class="form-control"/></div>
        <div class="form-group"><label>Total Rooms</label><input type="number" name="total_rooms" value="20" class="form-control"/></div>
      </div>
      <div class="form-group"><label>Facilities (comma separated)</label><input type="text" name="facilities" placeholder="Wi-Fi, AC, Pool" class="form-control"/></div>
      <div class="form-group"><label>Description</label><textarea name="description" rows="3" class="form-control"></textarea></div>
      <div class="form-group"><label>Upload Image</label><input type="file" name="image" accept="image/*" class="form-control"/></div>
      <div class="form-group"><label>Or Image URL</label><input type="url" name="image_url" placeholder="https://..." class="form-control"/></div>
      <button type="submit" class="btn-primary btn-block">Add Hotel</button>
    </form>
  </div>
</div>

<%- include('./partials/admin-footer') %>
