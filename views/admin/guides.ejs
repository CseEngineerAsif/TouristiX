<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-user-tie"></i> Guides</h3>
    <button class="btn-primary" onclick="document.getElementById('addGuideModal').style.display='flex'"><i class="fas fa-plus"></i> Add Guide</button>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Image</th><th>Name</th><th>Specialty</th><th>Price/Day</th><th>Rating</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% guides.forEach(g => { %>
        <tr>
          <td><img src="<%= g.image %>" alt="" style="width:60px;height:40px;object-fit:cover;border-radius:8px" onerror="this.src='/images/placeholder.jpg'"/></td>
          <td><strong><%= g.name %></strong></td>
          <td><%= g.specialty || '-' %></td>
          <td>BDT <%= (g.price_per_day || 0).toLocaleString() %></td>
          <td><i class="fas fa-star" style="color:#f59e0b"></i> <%= g.rating %></td>
          <td><%= g.available ? 'Available' : 'Unavailable' %></td>
          <td>
            <a href="/admin/guides/<%= g.id %>/edit" class="btn-sm"><i class="fas fa-pen"></i></a>
            <form action="/admin/guides/<%= g.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
              <button type="submit" class="btn-danger-sm"><i class="fas fa-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="addGuideModal" class="modal" style="display:none">
  <div class="modal-box modal-lg">
    <div class="modal-header">
      <h3>Add Guide</h3>
      <button onclick="document.getElementById('addGuideModal').style.display='none'" class="modal-close">&times;</button>
    </div>
    <form action="/admin/guides/add" method="POST" enctype="multipart/form-data" class="modal-form">
      <div class="form-row">
        <div class="form-group"><label>Name</label><input type="text" name="name" required class="form-control"/></div>
        <div class="form-group"><label>Specialty</label><input type="text" name="specialty" class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Languages</label><input type="text" name="languages" placeholder="Bengali,English" class="form-control"/></div>
        <div class="form-group"><label>Experience</label><input type="text" name="experience" placeholder="5 Years" class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Rating</label><input type="number" name="rating" min="0" max="5" step="0.1" value="0" class="form-control"/></div>
        <div class="form-group"><label>Price Per Day (BDT)</label><input type="number" name="price_per_day" value="1000" class="form-control"/></div>
      </div>
      <div class="form-group"><label>Phone</label><input type="text" name="phone" class="form-control"/></div>
      <div class="form-group"><label>Bio</label><textarea name="bio" rows="3" class="form-control"></textarea></div>
      <div class="form-group"><label><input type="checkbox" name="available" checked/> Available</label></div>
      <div class="form-group"><label>Upload Image</label><input type="file" name="image" accept="image/*" class="form-control"/></div>
      <div class="form-group"><label>Or Image URL</label><input type="url" name="image_url" placeholder="https://..." class="form-control"/></div>
      <button type="submit" class="btn-primary btn-block">Add Guide</button>
    </form>
  </div>
</div>

<%- include('./partials/admin-footer') %>
