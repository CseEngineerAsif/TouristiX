<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-bus"></i> Transport</h3>
    <button class="btn-primary" onclick="document.getElementById('addTransportModal').style.display='flex'"><i class="fas fa-plus"></i> Add Transport</button>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Type</th><th>Company</th><th>Route</th><th>Departure</th><th>Price</th><th>Seats</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% transports.forEach(t => { %>
        <tr>
          <td><strong><%= t.type %></strong></td>
          <td><%= t.company || '-' %></td>
          <td><%= t.from_location %> → <%= t.to_location %></td>
          <td><%= t.departure_time || '-' %></td>
          <td>BDT <%= (t.price || 0).toLocaleString() %></td>
          <td><%= t.seats_available %></td>
          <td>
            <a href="/admin/transport/<%= t.id %>/edit" class="btn-sm"><i class="fas fa-pen"></i></a>
            <form action="/admin/transport/<%= t.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
              <button type="submit" class="btn-danger-sm"><i class="fas fa-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="addTransportModal" class="modal" style="display:none">
  <div class="modal-box modal-lg">
    <div class="modal-header">
      <h3>Add Transport</h3>
      <button onclick="document.getElementById('addTransportModal').style.display='none'" class="modal-close">&times;</button>
    </div>
    <form action="/admin/transport/add" method="POST" enctype="multipart/form-data" class="modal-form">
      <div class="form-group">
        <label>Owner (optional)</label>
        <select name="owner_user_id" class="form-control">
          <option value="">Unassigned</option>
          <% (owners || []).forEach(o => { %>
            <option value="<%= o.id %>"><%= o.name %> (<%= o.email %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Type</label><input type="text" name="type" required class="form-control" placeholder="Bus/Train/Air"/></div>
        <div class="form-group"><label>Company</label><input type="text" name="company" class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>From</label><input type="text" name="from_location" required class="form-control"/></div>
        <div class="form-group"><label>To</label><input type="text" name="to_location" required class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Departure Time</label><input type="text" name="departure_time" placeholder="10:00 PM" class="form-control"/></div>
        <div class="form-group"><label>Price (BDT)</label><input type="number" name="price" required class="form-control"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Seats Available</label><input type="number" name="seats_available" value="40" class="form-control"/></div>
      </div>
      <div class="form-group"><label>Upload Image</label><input type="file" name="image" accept="image/*" class="form-control"/></div>
      <div class="form-group"><label>Or Image URL</label><input type="url" name="image_url" placeholder="https://..." class="form-control"/></div>
      <button type="submit" class="btn-primary btn-block">Add Transport</button>
    </form>
  </div>
</div>

<%- include('./partials/admin-footer') %>
