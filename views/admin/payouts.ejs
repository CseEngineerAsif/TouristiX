<%- include('./partials/admin-header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3><i class="fas fa-money-bill-wave"></i> Escrow Payouts</h3>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Booking</th>
          <th>Payer</th>
          <th>Provider</th>
          <th>Amount</th>
          <th>Commission</th>
          <th>Escrow</th>
          <th>Booking Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!payouts || payouts.length === 0) { %>
          <tr><td colspan="9" class="text-muted">No escrow records found.</td></tr>
        <% } else { %>
          <% payouts.forEach((p, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td>
                <strong><%= p.item_name || '-' %></strong><br/>
                <small><%= p.booking_type %> | Booking ID: <%= p.booking_id %></small>
              </td>
              <td><%= p.payer_name %><br/><small><%= p.payer_email %></small></td>
              <td><%= p.provider_name || 'Unassigned' %><br/><small><%= p.provider_email || '-' %></small></td>
              <td>BDT <%= (p.amount || 0).toLocaleString() %></td>
              <td>BDT <%= (p.provider_commission_amount || 0).toLocaleString() %></td>
              <td><small><%= p.status %></small></td>
              <td><small><%= p.booking_status %></small></td>
              <td>
                <% if (p.status === 'held' && p.booking_status === 'completed') { %>
                  <form action="/admin/payouts/<%= p.id %>/release" method="POST">
                    <button type="submit" class="btn-sm">Release</button>
                  </form>
                <% } else { %>
                  <small class="text-muted">N/A</small>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('./partials/admin-footer') %>
